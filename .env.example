SHIPMAIL_API_KEY=sm_live_replace_me
SHIPMAIL_MAILBOX_ID=replace_me
SHIPMAIL_WEBHOOK_SECRET=whsec_replace_me
ANTHROPIC_API_KEY=sk-ant-replace_me
PORT=3000

# Optional, and required if you run more than one instance. Without it,
# deduplication is in-memory and per-process, so each instance would reprocess
# retries the others already handled.
REDIS_URL=

# Required. Comma-separated exact addresses or domain entries such as *@example.com.
SHIPMAIL_ALLOWED_SENDERS=customer@example.com

# Optional. URLs are removed from model input unless their public HTTPS host is listed here.
SHIPMAIL_ALLOWED_URL_HOSTS=

# Drafts are never sent unless this is explicitly set to true.
AUTO_SEND=false

# Defaults to true when AUTO_SEND=true, and false otherwise. Uncomment to opt in explicitly.
# REQUIRE_AUTHENTICATED_SENDER=true
